# Live mode: OP Sepolia (L2, OP Stack) settling on RL1, the EVM-based Regulated Layer One (here: Sepolia).
# The values below are also the built-in defaults, so only GATEWAY_PRIVATE_KEY is required.
# Put it in .env.local (local) or in Vercel -> Settings -> Environment Variables.
# Without a gateway key the app runs in Simulation mode only.

L1_RPC_URL=https://sepolia.gateway.tenderly.co
L2_RPC_URL=https://sepolia.optimism.io
L1_NAME=RL1 · Sepolia
L2_NAME=OP Sepolia
L1_EXPLORER_URL=https://sepolia.etherscan.io
L2_EXPLORER_URL=https://optimism-sepolia.blockscout.com

# Gateway key: deploys S-EUR and pays the L2 fees. Use a FRESH key for this demo only,
# funded with a little OP Sepolia ETH from a faucet (https://console.optimism.io/faucet).
GATEWAY_PRIVATE_KEY=

# Optional
CUSTODY_SEED=sparkassen-demo-hsm   # derives the per-IBAN customer wallets
DEMO_ACCESS_TOKEN=                 # set this on public Vercel deployments
